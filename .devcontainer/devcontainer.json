{
  "name": "DWEC - E10-EnviosStrategy",
  "build": { "dockerfile": "Dockerfile" },
  "runArgs": ["--security-opt", "label=disable"],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "usernamehw.errorlens",
        "bierner.markdown-mermaid"
      ]
